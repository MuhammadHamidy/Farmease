	"item": [
		{
			"name": "SSO Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"pm.environment.set(\"token\", response.token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"operator_kebun\",\n  \"password\": \"password123\"\n}"
						},
						"url": "{{sso_url}}/api/auth/login"
					}
				}
			]
		},
