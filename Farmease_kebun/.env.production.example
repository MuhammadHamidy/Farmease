# Kebun Frontend Production Environment Example
# Copy this file to .env.production for production deployment

VITE_ENV=production
VITE_API_BASE_URL=https://kebun-api.farmease.id
VITE_KEBUN_API_URL=https://kebun-api.farmease.id
VITE_SSO_API_URL=https://sso-api.farmease.id

VITE_APP_NAME=Farmease Kebun Production
VITE_APP_VERSION=1.0.0
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_LOG_LEVEL=error
VITE_API_TIMEOUT=30000
