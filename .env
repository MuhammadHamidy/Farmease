# Database — selaras Farmease-BE/farmease/config/config.json (user/pass, farmease_be, port 5435)
DB_USER=user
DB_PASSWORD=pass
DB_NAME=farmease_be

# Port Database Mandiri
SSO_DB_PORT=5435
PETERNAKAN_DB_PORT=5436
KEBUN_DB_PORT=5437

# Port Redis Mandiri
SSO_REDIS_PORT=6381
PETERNAKAN_REDIS_PORT=6382
KEBUN_REDIS_PORT=6383

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Backend
APP_ENV=development
BACKEND_PORT=8080
JWT_SECRET=farmease-secret-key-123

# Frontend (URL yang dipanggil browser, bukan nama container)
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080
